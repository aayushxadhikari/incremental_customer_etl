# Copy this file to config/db.env and fill in real values.
# config/db.env is gitignored — never commit real credentials.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DB=customer_db
MYSQL_USER=customer_etl
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# Absolute path to the MySQL Connector/J jar used by Spark JDBC.
MYSQL_JAR=drivers/mysql-connector-j.jar
SPARK_MASTER=local[2]
SPARK_SHUFFLE_PARTITIONS=4
JDBC_PARTITIONS=1
JDBC_FETCH_SIZE=1000
JDBC_BATCH_SIZE=1000
